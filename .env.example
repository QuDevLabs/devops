# ===== Project =====
PROJECT_NAME=devops
KUBECONFIG=${KUBECONFIG:-~/.kube/config}

# ===== GitHub (GitOps source repo) =====
# Required: repo URL + deploy key token for git operations
GITHUB_REPO_URL=https://github.com/QuDevLabs/devops.git
GITHUB_TOKEN=

# ===== ArgoCD =====
# ARGOCD_ADMIN_PASS: leave empty → install-argocd.sh auto-generates and writes back
ARGOCD_URL=https://argocd.localhost
ARGOCD_ADMIN=admin
ARGOCD_ADMIN_PASS=

# ===== PostgreSQL (runtime secret, injected to K8s) =====
# Leave empty on first run — init-secrets.sh auto-generates.
# Rotate anytime: change value here → bootstrap/dev.sh setup --force
POSTGRES_PASSWORD=
POSTGRES_USER_PASSWORD=
POSTGRES_REPLICATION_PASSWORD=
